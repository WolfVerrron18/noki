# Порт сервера: фронт в dev проксирует /api сюда, на проде — Nginx
PORT=8090
# PostgreSQL. Не задан — локальная база PGlite в ./data (только для разработки)
DATABASE_URL=
# Секрет подписи токенов входа: длинная случайная строка (на проде обязателен)
JWT_SECRET=change-me

# Бот. Токен — от @BotFather, это секрет: не коммитить и не пересылать
TELEGRAM_BOT_TOKEN=
# Имя бота без @ и короткое имя мини-аппа (BotFather → Configure Mini App): ссылки t.me/<бот>/<имя>
BOT_USERNAME=nidoki_bot
APP_SHORT_NAME=app
# Как бот получает сообщения: off — никак; polling — сам спрашивает Telegram (для разработки, домен не нужен);
# webhook — Telegram присылает на PUBLIC_URL (прод)
BOT_MODE=off
# Публичный адрес сервиса (https://…): вебхук и кнопка мини-аппа в меню бота
PUBLIC_URL=
# Секрет вебхука (от 16 символов): Telegram присылает его в заголовке
TELEGRAM_WEBHOOK_SECRET=
# Чат, куда бот пересылает отзывы (Telegram id разработчика)
FEEDBACK_CHAT_ID=

# Вход тестовым пользователем без Telegram. На проде не включать
NIDOKI_DEV_AUTH=1
