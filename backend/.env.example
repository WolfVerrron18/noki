# Порт сервера: фронт в dev проксирует /api сюда
PORT=8090
# PostgreSQL. Не задан — локальная база PGlite в ./data (только для разработки)
DATABASE_URL=
# Секрет подписи токенов входа: длинная случайная строка
JWT_SECRET=change-me
# Токен бота: проверка входа через Telegram и сообщения
TELEGRAM_BOT_TOKEN=
# Чат, куда бот пересылает отзывы (id разработчика)
FEEDBACK_CHAT_ID=
# Вход тестовым пользователем без Telegram. На проде не включать
NIDOKI_DEV_AUTH=1
